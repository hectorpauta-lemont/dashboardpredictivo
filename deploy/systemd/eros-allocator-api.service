[Unit]
Description=EROS Allocator Django API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=eros-allocator
Group=www-data
WorkingDirectory=/opt/eros-allocator
EnvironmentFile=/etc/eros-allocator/eros.env
ExecStart=/opt/eros-allocator/venv/bin/gunicorn config.wsgi:application --bind 127.0.0.1:8000 --workers 2 --timeout 60 --access-logfile - --error-logfile -
StandardOutput=journal
StandardError=journal
SyslogIdentifier=eros-allocator-api
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
