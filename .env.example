# Plantilla comun para los dos modos de ejecucion. No contiene secretos reales.
#  - Local: copia este archivo a .env en la raiz del proyecto.
#  - EC2:   copia el contenido a /etc/eros-allocator/eros.env (permisos 0640,
#           root:eros-allocator). Nunca se sube al repositorio -- ver .gitignore.

DJANGO_SECRET_KEY=change-this-to-a-random-value-at-least-50-chars-long
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# En EC2 usar, por ejemplo:
# DJANGO_DEBUG=False
# DJANGO_ALLOWED_HOSTS=<dominio-del-allocator>
# DJANGO_CSRF_TRUSTED_ORIGINS=https://<dominio-del-allocator>
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_SESSION_COOKIE_SECURE=True
# DJANGO_CSRF_COOKIE_SECURE=True
# Primero dejar HSTS en 0; despues de validar HTTPS, usar 31536000.
# DJANGO_SECURE_HSTS_SECONDS=0
# DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
# DJANGO_SECURE_HSTS_PRELOAD=False

# Link internal API service token (DRF TokenAuthentication, header
# 'Authorization: Token <token>'). Reusa el MISMO token que eros-prime-gate
# ya tiene configurado -- confirmado por el equipo, no es uno separado.
LINK_API_TOKEN=
LINK_API_BASE_URL=https://api.thinknow.link/api/v1

# JWT personal temporal -- SOLO para /surveysupplier-allocations-optimized/,
# que exige 'Authorization: Bearer <jwt>' y no acepta el token de servicio.
# Si esta vacio o vencido, ese endpoint se trata como "sin datos", nunca como
# error fatal (ver intake/link_client.py). Vence rapido; renovar a mano.
LINK_JWT_TOKEN=

# API key que dashboard/ consumers deben mandar en el header 'X-API-Key'.
# Generar una distinta por entorno: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# Observabilidad.
LOG_LEVEL=INFO
# Edad maxima del heartbeat de un worker antes de reportarlo degradado en
# /health/worker/. 600 deja margen para el poll-interval de earnings (300s).
WORKER_HEALTH_MAX_AGE_SECONDS=600

# Alertas de performance (IR bajo, terminacion alta) -- email via django-ses
# (rol IAM en produccion, `aws configure` en local) y Telegram. Reusa los
# MISMOS canales/destinatarios que eros-prime-gate.
AWS_SES_REGION_NAME=
DEFAULT_FROM_EMAIL=
PERFORMANCE_ALERT_EMAILS=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Base de datos:
#  - DJANGO_DEBUG=True  -> SQLite local, estas variables se ignoran.
#  - DJANGO_DEBUG=False -> PostgreSQL RDS, todas obligatorias, HOST != localhost.
# Mismo patron que eros-prime-gate: parametros separados, nunca DATABASE_URL.
# Ejemplo de produccion:
# DB_ENGINE=django.db.backends.postgresql
# DB_HOSTNAME=<endpoint-privado-de-rds>
# DB_NAME=eros_allocator_db
# DB_USERNAME=<usuario-de-rds>
# DB_PASSWORD='<contrasena-segura>'
# DB_SSLMODE=require
DB_ENGINE=
DB_HOSTNAME=
DB_PORT=5432
DB_NAME=
DB_USERNAME=
DB_PASSWORD=
DB_SSLMODE=require
DATABASE_CONN_MAX_AGE=60
